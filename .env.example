# Copy to .env and fill in. .env is gitignored.

# Strava app — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Whoop app — https://developer.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Local OAuth callback port (both providers redirect here during auth)
OAUTH_CALLBACK_PORT=8765
