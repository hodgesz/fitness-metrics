<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hodgesz.fitness-metrics-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/launchd/sync-wrapper.sh</string>
    </array>

    <!-- Fires at 5:00 AM local every day. If the Mac is asleep at that
         time, StartCalendarInterval coalesces to fire once on next wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>FITNESS_METRICS_REPO</key>
        <string>__REPO__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/sync.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/sync.err</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
